---
import Section from './Section.astro';
import Snapshot from './Snapshot.astro';
import asleep from '../assets/photos/asleep-on-dog-bed.jpg';
import walk from '../assets/photos/walk-by-the-field.jpg';

// TODO: Weiping is asking the dogs' owners if we can use these photos. Remove any photo an owner says no to.
const groups = [
  {
    title: 'At our home',
    photo: { src: asleep, alt: 'A curly apricot dog curled up asleep on a dog bed', caption: 'Settled in for the night', position: 'center 60%', tilt: 'left', asleep: true },
    services: [
      { name: 'Boarding', text: "Overnight stays while you're away. Your dog eats, plays and sleeps as part of the family." },
      { name: 'Doggy daycare', text: "A relaxed day at our place while you're at work or busy." },
    ],
  },
  {
    title: 'At your home',
    photo: { src: walk, alt: 'A red and white dog on a leash, sniffing the grass beside a path', caption: 'Out for a walk', position: 'center 70%', tilt: 'right', asleep: false },
    services: [
      { name: 'House sitting', text: 'I stay overnight in your home, so your dog keeps their own bed and routine.' },
      { name: 'Drop-in visits', text: 'I stop by to feed your dog, play with them and let them out while you’re gone.' },
      { name: 'Dog walking', text: 'A walk around your neighbourhood, at your dog’s pace.' },
    ],
  },
] as const;
---

<Section id="services" title="How we can help" lead="Your dog can stay with us, or I can come to them. Every booking includes photo updates.">
  <div class="grid gap-16 md:grid-cols-2 md:gap-12 lg:gap-20">
    {groups.map((group) => (
      <div>
        <div class="relative max-w-[30rem]">
          <Snapshot
            src={group.photo.src}
            alt={group.photo.alt}
            caption={group.photo.caption}
            tilt={group.photo.tilt}
            ratio="4/3"
            position={group.photo.position}
            sizes="(min-width: 768px) 40vw, 90vw"
          />
          {/* Little drawn z's above a sleeping dog, in the same brown pen as the puppy. */}
          {group.photo.asleep && (
            <svg
              class="pointer-events-none absolute top-[14%] right-[16%] w-[64px] stroke-brown sm:w-[76px]"
              viewBox="0 0 80 60"
              fill="none"
              stroke-width="3.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M8 44H18L8 56H18M24 22H38L24 38H38M46 2H66L46 22H66" />
            </svg>
          )}
        </div>
        <h3 class="mt-10 text-[1.75rem]">{group.title}</h3>
        <dl class="mt-4 space-y-5">
          {group.services.map((s) => (
            <div>
              <dt class="text-[1.25rem] font-bold">{s.name}</dt>
              <dd class="mt-0.5 text-brown-soft">{s.text}</dd>
            </div>
          ))}
        </dl>
      </div>
    ))}
  </div>
  <p class="mt-12"><a href="#prices" class="font-bold">See prices for each service</a></p>
</Section>
