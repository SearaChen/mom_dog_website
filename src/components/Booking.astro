---
import Section from './Section.astro';
import AvailabilityCalendar from './AvailabilityCalendar.astro';
import InquiryForm from './InquiryForm.astro';
import Puppy from './Puppy.astro';
import { site } from '../site';

const steps = [
  'Check the calendar for open days.',
  'Send a booking request with your dates and a little about your dog.',
  `${site.ownerName} replies by email to confirm, then sends payment details and next steps.`,
];
---

<Section id="booking" title="Book a stay" lead="Booking is simple, and nothing is final until I’ve confirmed by email.">
  <ol class="grid max-w-5xl gap-6 md:grid-cols-3 md:gap-10">
    {steps.map((step, i) => (
      <li class="flex gap-4">
        <span class="font-heading text-[2.25rem] leading-none font-semibold text-accent-dark" aria-hidden="true">{i + 1}</span>
        <span class="pt-1"><span class="sr-only">Step {i + 1}: </span>{step}</span>
      </li>
    ))}
  </ol>

  <div class="mt-14 grid items-start gap-12 lg:grid-cols-[1fr_1.35fr]">
    <div class="space-y-4">
      <h3 class="text-[1.5rem]">Open days</h3>
      <AvailabilityCalendar />
      <p class="text-brown-soft">
        Prefer to talk? Call me at <a href={`tel:${site.phoneLink}`} class="whitespace-nowrap">{site.phoneDisplay}</a>{' '}
        or email <a href={`mailto:${site.email}?subject=Booking%20request`}>{site.email}</a>.
      </p>
    </div>
    <div class="relative space-y-4">
      <h3 class="text-[1.5rem]">Booking request</h3>
      <Puppy class="right-5 top-[-0.875rem] w-[120px] sm:right-12 sm:top-[-1.8rem] sm:w-[150px]" />
      <InquiryForm />
    </div>
  </div>
</Section>
