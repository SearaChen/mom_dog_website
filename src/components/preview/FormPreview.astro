---
// EXAMPLE ONLY: a pretend booking form, so people can see what the real one will look like.
// Nothing typed here is sent anywhere. It shows only while PUBLIC_WEB3FORMS_KEY is missing
// (see InquiryForm.astro), so it disappears by itself once that key is set.
//
// To delete it for good:
//   1. Delete this whole folder: src/components/preview/
//   2. In src/components/AvailabilityCalendar.astro, delete the two lines marked "EXAMPLE".
//   3. In src/components/InquiryForm.astro, delete the two lines marked "EXAMPLE".
---

<form id="example-form" class="mt-4 space-y-5 rounded-xl bg-paper p-5 text-left shadow-soft sm:p-8" aria-label="Example booking form, not connected yet">
  <p class="font-heading italic text-brown-soft">Example only. This form isn’t connected yet, so nothing is sent.</p>

  <div class="grid gap-5 sm:grid-cols-2">
    <label class="block font-semibold">Your name <input class="field" autocomplete="off" /></label>
    <label class="block font-semibold">Email <input type="email" class="field" autocomplete="off" /></label>
    <label class="block font-semibold">
      Phone <span class="font-normal text-brown-soft">(optional)</span>
      <input type="tel" class="field" autocomplete="off" />
    </label>
    <label class="block font-semibold">
      Service
      <select class="field">
        <option>Boarding</option>
        <option>Daycare</option>
        <option>House sitting</option>
        <option>Drop-in visit</option>
        <option>Dog walking</option>
        <option>Not sure yet</option>
      </select>
    </label>
    <label class="block font-semibold">Start date <input type="date" class="field" /></label>
    <label class="block font-semibold">End date <input type="date" class="field" /></label>
  </div>

  <label class="block font-semibold">
    Your dog
    <span class="block font-normal text-brown-soft">Name, breed, and age</span>
    <input class="field" autocomplete="off" />
  </label>

  <label class="block font-semibold">
    Anything else I should know?
    <span class="block font-normal text-brown-soft">Feeding, medication, personality</span>
    <textarea rows="4" class="field"></textarea>
  </label>

  <button type="submit" class="btn w-full sm:w-auto">Send booking request</button>
  <p data-result role="status" class="font-semibold"></p>
</form>

<script>
  // Nothing is sent: just explain, so nobody thinks their request went through.
  const form = document.getElementById('example-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    form.querySelector('[data-result]')!.textContent =
      "This form isn't connected yet, so nothing was sent. Please call or email me instead.";
  });
</script>
