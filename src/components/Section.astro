---
// Shared wrapper for every page section: anchor id, heading, optional intro line.
interface Props {
  id: string;
  title: string;
  lead?: string;
  alt?: boolean; // sand background instead of cream
  narrow?: boolean; // narrower column for text-heavy sections
}
const { id, title, lead, alt = false, narrow = false } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class:list={['py-16 md:py-24', alt && 'bg-sand']}>
  <div class:list={['mx-auto px-5', narrow ? 'max-w-3xl' : 'max-w-6xl']}>
    <h2 id={`${id}-title`} class="text-[2rem] md:text-[2.625rem]">{title}</h2>
    {lead && <p class="mt-3 max-w-[38rem] text-brown-soft">{lead}</p>}
    <div class="mt-10 md:mt-12">
      <slot />
    </div>
  </div>
</section>
