---
// A small paw print. Decoration only, so screen readers skip it.
interface Props {
  size?: number;
  class?: string;
}
const { size = 16, class: className } = Astro.props;
---

<svg class={className} aria-hidden="true" width={size} height={size} viewBox="0 0 24 24" fill="currentColor">
  <ellipse cx="12" cy="16.5" rx="5.2" ry="4.5" />
  <ellipse cx="5" cy="10.5" rx="2.1" ry="2.7" />
  <ellipse cx="9.3" cy="6" rx="2.1" ry="2.8" />
  <ellipse cx="14.7" cy="6" rx="2.1" ry="2.8" />
  <ellipse cx="19" cy="10.5" rx="2.1" ry="2.7" />
</svg>
