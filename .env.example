# Copy this file to .env for local testing. On GitHub, set these as
# repository Variables (Settings → Secrets and variables → Actions → Variables).
# All three end up in the public page, so none of them is a secret.

# Google Calendar ID of the dedicated "Boarding availability" calendar
# (Google Calendar → calendar settings → "Integrate calendar" → Calendar ID).
PUBLIC_GOOGLE_CALENDAR_ID=

# Google Cloud API key with only the Google Calendar API enabled,
# restricted to the website's address (HTTP referrer restriction).
PUBLIC_GOOGLE_API_KEY=

# Web3Forms access key, created at web3forms.com with the Gmail address
# that should receive inquiries.
PUBLIC_WEB3FORMS_KEY=
